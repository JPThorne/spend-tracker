<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SpendTracker</AssemblyName>
    <OutputType>WinExe</OutputType>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.0.7.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpendTracker.Domain\SpendTracker.Domain.csproj" />
    <ProjectReference Include="..\SpendTracker.Infrastructure\SpendTracker.Infrastructure.csproj" />
    <ProjectReference Include="..\SpendTracker.Updater\SpendTracker.Updater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\index.html" />
    <EmbeddedResource Include="wwwroot\app.js" />
    <EmbeddedResource Include="wwwroot\styles.css" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="appsettings.json" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="BuildUpdater" BeforeTargets="Build">
    <Exec Command="dotnet publish ..\SpendTracker.Updater\SpendTracker.Updater.csproj -c $(Configuration) -r win-x64 --self-contained -p:PublishSingleFile=true -p:PublishReadyToRun=true -o obj\updater_publish\" />
  </Target>

  <Target Name="IncludeUpdater" BeforeTargets="Build" AfterTargets="BuildUpdater">
    <ItemGroup>
      <EmbeddedResource Include="obj\updater_publish\SpendTrackerUpdater.exe">
        <Link>Resources\SpendTrackerUpdater.exe</Link>
        <LogicalName>SpendTracker.Api.Resources.SpendTrackerUpdater.exe</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
